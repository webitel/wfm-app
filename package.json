{
	"name": "@webitel/wfm",
	"version": "26.8.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check:libs-train": "node scripts/check-webitel-train.mjs",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test:unit": "vitest",
		"build-only": "vite build",
		"typecheck": "vue-tsc --noEmit -p ./tsconfig.json",
		"lint:fix": "npx biome check --write ./src",
		"lint:fix-staged": "npx lint-staged",
		"utils:up-lib": "npm up @webitel/ui-sdk @webitel/ui-datalist && npm ls @webitel/ui-sdk @webitel/ui-datalist",
		"utils:link-libs": "npm link @webitel/api-services @webitel/ui-sdk @webitel/ui-datalist && npm ls @webitel/api-services @webitel/ui-sdk @webitel/ui-datalist",
		"prepare": "husky",
		"biome:ci:gh": "biome ci ./src --reporter=github",
		"test:unit:ci": "vitest run --coverage",
		"typecheck:ci": "true"
	},
	"dependencies": {
		"@vueuse/core": "^14.x",
		"@webitel/api-services": "~26.8",
		"@webitel/ui-datalist": "~26.8",
		"@webitel/ui-sdk": "~26.8",
		"axios": "^1.18.1",
		"clipboard-copy": "^4.0.1",
		"lodash-es": "^4.17.21",
		"pinia": "^3.0.4",
		"vue": "^3.5.x",
		"vue-i18n": "^11.x",
		"vue-router": "^4.x",
		"vuex": "^4.1.0",
		"webitel-sdk": "^26.4.8",
		"zod": "^4.x"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@tsconfig/node22": "^22.0.2",
		"@types/jsdom": "^21.1.7",
		"@types/node": "^22.18.6",
		"@vitejs/plugin-vue": "^6.0.1",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.7.0",
		"globals": "^17.x",
		"husky": "^9.1.7",
		"jiti": "^2.5.1",
		"jsdom": "^27.0.0",
		"npm-run-all2": "^8.0.4",
		"sass": "^1.102.0",
		"tslib": "^2.7.0",
		"typescript": "^5.9.x",
		"vite": "npm:rolldown-vite@^7.3.x",
		"vite-plugin-checker": "^0.12.x",
		"vite-plugin-svg-sprite": "=0.6.3",
		"vite-plugin-vue-devtools": "^8.x",
		"vitest": "^4.x",
		"vue-tsc": "^3.x"
	},
	"optionalDependencies": {
		"@esbuild/darwin-arm64": "^0.24.0",
		"@rollup/rollup-linux-x64-gnu": "4.9.5"
	},
	"overrides": {
		"vite": "npm:rolldown-vite@^7.3.x"
	}
}
